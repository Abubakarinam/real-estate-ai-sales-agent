# Copy this file to .env and fill it in. Never commit .env.

# Your Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model and effort. low effort = fast, cheap chat replies.
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# Staff dashboard password (change it!)
ADMIN_PASSWORD=demo1234

# Optional: send every lead, booking and handoff to n8n / Make / Zapier (e.g. into Google Sheets or a CRM)
LEAD_WEBHOOK_URL=

# Optional: your agency
AGENCY_NAME=Harbor & Key Realty
AGENCY_CITY=Dubai
AGENCY_TIMEZONE=Asia/Dubai
